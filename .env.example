# Copy to .env before `docker compose up`
# ---------------------------------------------------------------
# IMPORTANT: These defaults are for LOCAL DEVELOPMENT ONLY.
# Before any shared or production deploy you MUST:
#   1. Generate a strong random JWT secret (>= 64 chars).
#   2. Replace POSTGRES_PASSWORD with a secure value.
#   3. Restrict CORS_ORIGINS to your domain(s).
#   4. Remove or rotate SEED_RESEARCHER_PASSWORD.
# ---------------------------------------------------------------

POSTGRES_USER=graymatter
POSTGRES_PASSWORD=graymatter_dev
POSTGRES_DB=graymatter
DATABASE_URL=postgresql+psycopg2://graymatter:graymatter_dev@postgres:5432/graymatter

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
GRAYMATTER_JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_SECRET=change-me-in-production-use-a-long-random-string
GRAYMATTER_SLICER_TOKEN_TTL_MINUTES=15

# Comma-separated browser origins in shared deployments (avoid "*" in production).
GRAYMATTER_CORS_ORIGINS=*

# Revision files retained per study. The current accepted revision is always preserved.
GRAYMATTER_SEGMENTATION_REVISION_RETENTION=100

# Set to redis for SSE fan-out across multiple backend workers.
GRAYMATTER_EVENT_BACKEND=memory
GRAYMATTER_REDIS_URL=redis://redis:6379/0

GRAYMATTER_AI_ROOT=/app/ai
GRAYMATTER_CHECKPOINT=/app/ai/checkpoints/model.pt

NEXT_PUBLIC_API_BASE_URL=/api
BACKEND_INTERNAL_URL=http://backend:8000

# Seeded researcher (local demo) — created on backend startup when set
SEED_RESEARCHER_EMAIL=researcher@graymatter.local
SEED_RESEARCHER_PASSWORD=researcher12345
SEED_RESEARCHER_NAME=Dev Researcher
